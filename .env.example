# auto: tenta OpenAI, depois Ollama, depois fallback local
# ollama: usa apenas IA local
# openai: usa apenas OpenAI API
# offline: gera uma trilha local sem IA
AI_PROVIDER=auto

OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-5.5

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

PORT=8766
MAX_UPLOAD_BYTES=26214400
PDF_TEXT_LIMIT=24000

# Supabase opcional.
# Enquanto estiver vazio, o sistema continua usando data/*.json localmente.
# Depois de criar o projeto no Supabase, cole os valores abaixo e reinicie o servidor.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui
